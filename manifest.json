{
    "name": "CPP Reference Revision Setter",
    "description": "CPP Reference Revision Setter",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "js": ["js/setup.js"],
            "matches": [
                "https://cppreference.com/cpp/*",
                "https://*.cppreference.com/cpp/*"
            ],
            "run_at": "document_idle"
        }
    ]
}
