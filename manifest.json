{
    "name": "CPP Reference Revision Setter",
    "description": "CPP Reference Revision Setter",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "html/popup.html"
    },
    "content_scripts": [
        {
            "js": ["js/set-revision.js"],
            "matches": [
                "https://cppreference.com/*",
                "https://*.cppreference.com/*"
            ],
            "run_at": "document_idle"
        }
    ]
}
